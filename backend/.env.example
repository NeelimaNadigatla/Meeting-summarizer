# Copy this file to .env and fill in your values.

# PostgreSQL connection. Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/meeting_summarizer

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# "mock" works offline with no API key. "claude" uses the Claude API.
SUMMARIZER_PROVIDER=mock
ANTHROPIC_API_KEY=

# Comma-separated list of frontend URLs allowed to call the API.
CORS_ORIGINS=http://localhost:5173
